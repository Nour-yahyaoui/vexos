#!/bin/sh
# VexOS Desktop - live-build configuration.
#
#   sh auto/config                          desktop profile (default)
#   VEXOS_PROFILE=minimal sh auto/config    terminal only
#   VEXOS_PROFILE=dev sh auto/config        desktop + compilers and Node.js
#
# Profiles are built from profiles/*.list:
#   minimal = base
#   desktop = base + desktop
#   dev     = base + desktop + dev
set -e
cd "$(dirname "$0")/.."

PROFILE=${VEXOS_PROFILE:-desktop}
case "$PROFILE" in
    minimal) LISTS="base" ;;
    desktop) LISTS="base desktop" ;;
    dev)     LISTS="base desktop dev" ;;
    *) echo "error: unknown profile '$PROFILE' (use minimal, desktop, or dev)" >&2; exit 1 ;;
esac

# 1. Package list for this profile (live-build reads config/package-lists/*.list.chroot)
mkdir -p config/package-lists
{
    echo "# Generated by auto/config. Profile: $PROFILE. Edit profiles/*.list instead."
    for l in $LISTS; do
        echo "# from profiles/$l.list"
        grep -v -e '^#' -e '^[[:space:]]*$' "profiles/$l.list"
    done
} > config/package-lists/vexos.list.chroot

# 2. Build the VexOS .deb packages; live-build installs them from config/packages.chroot
sh packages/build-debs.sh config/packages.chroot

# 3. live-build configuration
VOL=$(echo "VEXOS_$PROFILE" | tr '[:lower:]' '[:upper:]')
lb config noauto \
    --mode debian \
    --distribution trixie \
    --archive-areas "main contrib non-free non-free-firmware" \
    --architectures amd64 \
    --linux-flavours amd64 \
    --binary-images iso-hybrid \
    --debian-installer none \
    --mirror-bootstrap "http://deb.debian.org/debian/" \
    --mirror-chroot "http://deb.debian.org/debian/" \
    --mirror-chroot-security "http://security.debian.org/debian-security" \
    --mirror-binary "http://deb.debian.org/debian/" \
    --mirror-binary-security "http://security.debian.org/debian-security" \
    --iso-application "VexOS Desktop ($PROFILE)" \
    --iso-publisher "VexOS" \
    --iso-volume "$VOL" \
    --bootappend-live "boot=live components quiet splash" \
    "$@"
