#!/bin/sh
# Runs inside the live system during the build: sets the VexOS identity.
set -e

cat > /etc/os-release <<'EOF'
PRETTY_NAME="VexOS Desktop 2.2.1 (Debian trixie)"
NAME="VexOS Desktop"
VERSION="2.2.1"
VERSION_ID="2.2.1"
ID=vexos
ID_LIKE=debian
HOME_URL="https://github.com/Nour-yahyaoui/vexos"
EOF

echo "VexOS Desktop 2.2.1 \n \l" > /etc/issue
echo "VexOS Desktop 2.2.1" > /etc/hostname
