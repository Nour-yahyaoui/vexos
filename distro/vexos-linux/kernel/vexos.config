# VexOS Linux kernel fragment
# Merged on top of x86_64 defconfig by build.sh (scripts/kconfig/merge_config.sh).
# Goal: small, monolithic kernel that boots from an initramfs inside VirtualBox.

CONFIG_LOCALVERSION="-vexos"
CONFIG_DEFAULT_HOSTNAME="vexos"

# No loadable modules: everything needed is built in (smaller, simpler image)
CONFIG_MODULES=n

# Boot: initramfs (the whole system lives in initrd.gz)
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_RD_XZ=y
CONFIG_INITRAMFS_SOURCE=""

# Boot paths for BIOS and UEFI (VirtualBox supports both)
CONFIG_EFI=y
CONFIG_EFI_STUB=y

# Virtual filesystems and basic FS support
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_DEVPTS=y
CONFIG_UNIX98_PTYS=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_ISO9660_FS=y

# Console and keyboard: serial + VGA text + PS/2 keyboard (VirtualBox default)
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_VGA_CONSOLE=y
CONFIG_SERIO=y
CONFIG_SERIO_I8042=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_INPUT_EVDEV=y

# Storage used by VirtualBox virtual disks and optical drives
CONFIG_ATA=y
CONFIG_ATA_SFF=y
CONFIG_ATA_BMDMA=y
CONFIG_ATA_PIIX=y
CONFIG_SATA_AHCI=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_BLK_DEV_SR=y

# Network: E1000 (VirtualBox default NIC) and virtio
CONFIG_NET=y
CONFIG_INET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_PCI=y
CONFIG_E1000=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_NET=y

# Graphics: simple framebuffer (works with VirtualBox's VGA adapter)
CONFIG_FB=y
CONFIG_FB_SIMPLE=y
CONFIG_SYSFB_SIMPLEFB=y

# Executables
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y

# Not needed in a terminal-only VM
CONFIG_SOUND=n
CONFIG_WIRELESS=n
CONFIG_BLUETOOTH=n
CONFIG_DRM=n
CONFIG_USB_SUPPORT=n
CONFIG_DEBUG_KERNEL=n
