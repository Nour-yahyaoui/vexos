#!/usr/bin/env python3
"""Matlab-vk: a small MATLAB-style calculator and plotter for VexOS.

  Matlab-vk                 interactive prompt (type quit or exit to leave)
  Matlab-vk script.mvk      run a script file
  Matlab-vk --help          show this help
  Matlab-vk --version       show the version

Figures open as pages in the browser. They are saved in ~/Matlab-vk/figures.
"""
import os
import sys

VERSION = "1.1-1"
SYSTEM_LIB = "/usr/lib/matlab-vk"
HERE_LIB = os.path.normpath(os.path.join(os.path.dirname(os.path.realpath(__file__)),
                                         "..", "lib", "matlab-vk"))
for lib in (os.environ.get("MATLAB_VK_LIB"), SYSTEM_LIB, HERE_LIB):
    if lib and os.path.isdir(lib) and lib not in sys.path:
        sys.path.insert(0, lib)

from lang import HELP, Interpreter, MatlabError  # noqa: E402
from figures import Graphics  # noqa: E402

USAGE = """usage: Matlab-vk [script.mvk]
       Matlab-vk --help | --version

Run with no arguments for the interactive prompt (quit or exit to leave).
"""


def out_dir():
    return os.environ.get("MATLAB_VK_FIGURES") or os.path.join(
        os.path.expanduser("~"), "Matlab-vk", "figures")


def has_display():
    return bool(os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY"))


def make_interpreter():
    def say(text="", end="\n"):
        sys.stdout.write(str(text) + end)
        sys.stdout.flush()

    gfx = Graphics(out_dir(), say, display=has_display() and not os.environ.get("MATLAB_VK_TEXT"))
    return Interpreter(gfx, say)


def join_continuations(lines):
    """Join lines ending in '...' so that each entry keeps its first line number."""
    out, buf, start = [], [], 0
    for n, line in enumerate(lines, 1):
        stripped = line.rstrip()
        if not buf:
            start = n
        if stripped.endswith("..."):
            buf.append(stripped[:-3])
            continue
        buf.append(line)
        out.append((start, " ".join(buf)))
        buf = []
    if buf:
        out.append((start, " ".join(buf)))
    return out


def run_script(path):
    try:
        with open(path, encoding="utf-8") as f:
            lines = f.read().splitlines()
    except OSError as err:
        print(f"Matlab-vk: cannot open '{path}': {err.strerror}", file=sys.stderr)
        return 1
    interp = make_interpreter()
    for lineno, text in join_continuations(lines):
        if not text.strip():
            continue
        try:
            interp.run(text)
        except MatlabError as err:
            print(f"error: {path}, line {lineno}: {err}", file=sys.stderr)
            return 1
        except RecursionError:
            print(f"error: {path}, line {lineno}: expression is too deeply nested", file=sys.stderr)
            return 1
    return 0


def repl():
    interp = make_interpreter()
    print(f"Matlab-vk {VERSION} · type help for commands, quit to exit")
    while True:
        try:
            line = input(">> ")
        except EOFError:
            print()
            return 0
        except KeyboardInterrupt:
            print()
            continue
        word = line.strip()
        if word in ("quit", "exit", "quit;", "exit;"):
            return 0
        if not word:
            continue
        try:
            interp.run(line)
        except MatlabError as err:
            print(f"error: {err}")
        except RecursionError:
            print("error: expression is too deeply nested")


def main(argv):
    if not argv:
        return repl()
    if argv[0] in ("-h", "--help", "help"):
        print(USAGE + "\n" + HELP, end="")
        return 0
    if argv[0] in ("-V", "--version"):
        print(f"Matlab-vk {VERSION}")
        return 0
    if argv[0].startswith("-"):
        print(f"Matlab-vk: unknown option '{argv[0]}'", file=sys.stderr)
        print(USAGE, end="", file=sys.stderr)
        return 2
    return run_script(argv[0])


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        print()
        sys.exit(130)
